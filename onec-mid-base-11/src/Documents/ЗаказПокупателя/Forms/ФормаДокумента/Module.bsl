#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	Если  (ТекущиеДанные.Скидка + Объект.СогласованнаяСкидка) <= 100 Тогда
		ТекущиеДанные.Сумма = (ТекущиеДанные.Цена - ТекущиеДанные.Цена * (ТекущиеДанные.Скидка + Объект.СогласованнаяСкидка)/100) * ТекущиеДанные.Количество;
	Иначе
		ТекущиеДанные.Сумма = 0;
		Сообщение = СтрШаблон("Неверно указана скидка на %1", ТекущиеДанные.Номенклатура); 
		Сообщить (Сообщение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуКаждойСтроки()
	
	Для Каждого ТекущаяСтрока Из Объект.Товары Цикл
		
		РассчитатьСуммуСтроки(ТекущаяСтрока) 
		
	КонецЦикла; 
	
	Для Каждого ТекущаяСтрока Из Объект.Услуги Цикл
		
		РассчитатьСуммуСтроки(ТекущаяСтрока) 
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура КомандаВопросАсинх()
	
	Ответ = Ждать ВопросАсинх("Пересчитать сумму с учетом скидки?", РежимДиалогаВопрос.ДаНет,,,); 
	Если Ответ = КодВозвратаДиалога.Да Тогда
		РассчитатьСуммуКаждойСтроки();
    КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

